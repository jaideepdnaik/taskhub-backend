# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
DATABASE_URL=postgres://taskhub:taskhub@localhost:5432/taskhub
REDIS_URL=redis://localhost:6380/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Ask TaskHub (RAG assistant) ---
# Embeddings (https://www.voyageai.com). Required for indexing and questions.
VOYAGE_API_KEY=
# Answer generation: "cli" uses your logged-in Claude Code (local dev only),
# "api" uses the Anthropic API with ANTHROPIC_API_KEY (required in production).
ASSISTANT_LLM_BACKEND=cli
# ASSISTANT_CLI_MODEL=sonnet
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5
