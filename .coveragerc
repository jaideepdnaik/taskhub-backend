# Coverage settings for `pytest --cov=apps`. Measures app code only.
[run]
source = apps
branch = True
omit =
    */migrations/*
    */tests/*

[report]
# CLAUDE.md target: CI fails if coverage drops below this.
fail_under = 85
show_missing = True
skip_covered = True
exclude_also =
    if TYPE_CHECKING:
    raise NotImplementedError
